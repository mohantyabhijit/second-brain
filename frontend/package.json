{
  "name": "@second-brain/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "React frontend for the Second Brain knowledge inbox.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cloudflare:build": "NEXT_OUTPUT=export next build",
    "cloudflare:deploy": "npm run cloudflare:build && npx wrangler deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "next": "^16.2.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  }
}
