# Frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend.
APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_STORAGE_BUCKET=sources

# Non-secret source controls.
X_BOOKMARK_LIMIT=0
X_REDIRECT_URI=http://localhost:8080/api/auth/x/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read bookmark.read offline.access
X_SESSION_SECRET=
X_TOKEN_ENCRYPTION_KEY=
YOUTUBE_PLAYLIST_ID=
YOUTUBE_TRANSCRIPT_TEST_VIDEO_ID=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-5.5
ONECLI_GATEWAY=false
WORKER_REFRESH_INTERVAL=2h
WORKER_DIGEST_INTERVAL=2h
REFRESH_TIMEOUT=90m
PROCESS_WORKER_COUNT=8
DIGEST_TIME=18:00
DIGEST_TIMEZONE=Asia/Singapore
GRAPH_SYNC_BATCH_SIZE=50

# Store real values in OneCLI, not in this file.
# SUPABASE_SERVICE_ROLE_KEY writes private Supabase Storage objects from the backend only.
# The Go backend owns X OAuth. X_TOKEN_ENCRYPTION_KEY must be the same 32-byte/base64 key in dev and prod.
# X_USER_ACCESS_TOKEN/X_REFRESH_TOKEN are legacy migration fallbacks; new auth stores encrypted tokens in Postgres.
# X_BOOKMARK_LIMIT=0 means fetch every available X bookmark page. Set a positive number for capped test runs.
# YOUTUBE_API_KEY can read public playlists. Private playlists need OAuth bearer access.
# YOUTUBE_ACCESS_TOKEN can test authenticated playlist access.
# SUPADATA_API_KEY fetches transcript text from public videos in native mode.
# OPENAI_API_KEY translates non-English transcript previews to English locally.
# OPENAI_CHAT_MODEL controls Ask Your Second Brain; use gpt-5.5 when your account has access.
# EXA_API_KEY enables latest-web context in Ask Your Second Brain when requested.
EXA_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
X_EXPECTED_USERNAME=mohantyabhijit
X_REAUTHORIZE_COMMAND="npm run x:oauth"
X_KEYCHAIN_TOKEN_SUFFIX=
X_TOKEN_ROTATION_PATH=./data/runtime/x-token-rotation.json
