# Non-secret local controls.
NEXT_PUBLIC_APP_URL=http://localhost:3000
YOUTUBE_PLAYLIST_ID=
YOUTUBE_TRANSCRIPT_TEST_VIDEO_ID=

# Store real values in OneCLI, not in this file.
# X_USER_ACCESS_TOKEN requires OAuth 2.0 PKCE scopes: bookmark.read tweet.read users.read.
# YOUTUBE_API_KEY can read public playlists. Private playlists need OAuth bearer access.
# YOUTUBE_ACCESS_TOKEN can test authenticated playlist access.
