APP_ENV=development
PORT=8080
APP_USER_ID=00000000-0000-0000-0000-000000000001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use the Supabase pooled Postgres connection string.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_STORAGE_BUCKET=sources

# Non-secret source controls.
X_BOOKMARK_LIMIT=0
X_REDIRECT_URI=http://localhost:8080/api/auth/x/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read bookmark.read offline.access
X_SESSION_SECRET=
X_TOKEN_ENCRYPTION_KEY=
YOUTUBE_PLAYLIST_ID=
YOUTUBE_TRANSCRIPT_TEST_VIDEO_ID=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ONECLI_GATEWAY=false
ONECLI_BIN=/Users/abhijitmohanty/.local/bin/onecli
ONECLI_PROJECT=second-brain
ONECLI_X_ACCESS_SECRET_ID=
ONECLI_X_REFRESH_SECRET_ID=
DIGEST_TIMEZONE=Asia/Singapore
DIGEST_TIME=18:00
WORKER_REFRESH_INTERVAL=2h
WORKER_DIGEST_INTERVAL=2h
REFRESH_TIMEOUT=90m
PROCESS_WORKER_COUNT=8
DIGEST_EMAIL_FROM=Second Brain <digest@second-brain.local>
DIGEST_EMAIL_TO=

# Store real provider values in OneCLI or export them only for local validation.
SUPABASE_SERVICE_ROLE_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_EXPECTED_USERNAME=mohantyabhijit
X_REAUTHORIZE_COMMAND="npm run x:oauth"
X_KEYCHAIN_TOKEN_SUFFIX=
X_TOKEN_REFRESH_DIRECT=false
X_TOKEN_ROTATION_PATH=../data/runtime/x-token-rotation.json
# Production X app credentials are normally stored in Keychain/GitHub, not this file:
# X_CLIENT_ID_PROD=
# X_CLIENT_SECRET_PROD=
# Legacy migration fallbacks only; backend OAuth stores encrypted tokens in Postgres.
X_USER_ACCESS_TOKEN=
X_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
SUPADATA_API_KEY=
OPENAI_API_KEY=
EXA_API_KEY=
RESEND_API_KEY=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_SYNC_BATCH_SIZE=50
